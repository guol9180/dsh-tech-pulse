{
  "name": "dsh-tech-pulse",
  "version": "1.4.0",
  "description": "Tech pulse — a DeepSeek Harness sidebar panel aggregating first-hand tech updates: Hacker News, publisher RSS, AI-lab announcements (OpenAI / Anthropic / DeepSeek / MSR), and GitHub activity from tech leaders, with an AI digest and on-demand Chinese translation.",
  "type": "module",
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "rss",
    "hacker-news",
    "github",
    "ai-news",
    "cordis"
  ],
  "license": "MIT",
  "author": "heguoliang",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/guol9180/dsh-tech-pulse.git"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  }
}
